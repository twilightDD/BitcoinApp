#ifndef PrefixHeader_pch
#define PrefixHeader_pch

// Include any system framework and library headers here that should be included in all compilation units.
// You will also need to set the Prefix Header build setting of one or more of your targets to reference this file.

#endif /* PrefixHeader_pch */


#define weakify(var) __weak typeof(var) AHKWeak_##var = var;

#define strongify(var) \
_Pragma("clang diagnostic push") \
_Pragma("clang diagnostic ignored \"-Wshadow\"") \
__strong typeof(var) var = AHKWeak_##var; \
_Pragma("clang diagnostic pop")

#pragma mark - Time measurement
#define TICK NSDate * startTime = [NSDate date];
#define TOCK NSLog(@"Elapsed Time: %f", [[NSDate date] timeIntervalSinceDate:startTime]);
#define TOCKwithComment(...) NSLog(@"Elapsed Time on %@:  %f", ## __VA_ARGS__, [[NSDate date] timeIntervalSinceDate:startTime]);

#define TICK2 NSDate * startTime2 = [NSDate date];
#define TOCK2 NSLog(@"Elapsed Time: %f", [[NSDate date] timeIntervalSinceDate:startTime2]);
#define TOCK2withComment(...) NSLog(@"Elapsed Time on %@:  %f", ## __VA_ARGS__, [[NSDate date] timeIntervalSinceDate:startTime2]);

#define TICK3 NSDate * startTime3 = [NSDate date];
#define TOCK3 NSLog(@"Elapsed Time: %f", [[NSDate date] timeIntervalSinceDate:startTime3]);
#define TOCK3withComment(...) NSLog(@"Elapsed Time on %@:  %f", ## __VA_ARGS__, [[NSDate date] timeIntervalSinceDate:startTime3]);
